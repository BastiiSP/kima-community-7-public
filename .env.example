# Neon: gepoolte PostgreSQL-Verbindung, niemals NEXT_PUBLIC_ verwenden.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# SMTP für Anmeldecodes (lokal alternativ Mailpit).
# Brevo Free: smtp-relay.brevo.com, Port 587, SMTP_SECURE=false (STARTTLS).
# SMTP_USER = Brevo SMTP-Login; SMTP_PASS = SMTP-Schlüssel, kein API-Schlüssel.
# SMTP_FROM = zuvor verifizierter Absender; nicht den technischen SMTP-Login verwenden.
# Ohne eigene Domain kann Brevo den sichtbaren Absender ersetzen.
# Konto/Transaktionsversand müssen freigeschaltet und echte Zustellung geprüft sein.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KIMA Community <community@example.com>

# Nur für lokale SMTP-Testserver, in Produktion wirkungslos.
SMTP_ALLOW_INSECURE=false

# Nur Produktion: getrenntes zufälliges Secret für den täglichen Vercel-Monitor.
# Die private Empfängeradresse ausschließlich in der Anbieter-Konfiguration setzen.
CRON_SECRET=
OPS_ALERT_EMAIL=
